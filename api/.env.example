# Copy to .env — `cargo sqlx` and the sqlx macros read DATABASE_URL from here.
DATABASE_URL=postgres://user:password@localhost:5436/scout_beam

# HS256 signing key.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

BIND_ADDR=0.0.0.0:8002
CORS_ALLOWED_ORIGIN=http://localhost:3001

# Required, dev | prod — anything else refuses to boot; only `dev` mounts POST /auth/dev-login
ENV=dev

# Left unset, the binary picks by ENV: verbose in dev, quiet in prod.
# RUST_LOG=scout_beam=debug,tower_http=debug,info
